{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"]
  },
  "env": {
    "builtin": true,
    "browser": true
  }
}
